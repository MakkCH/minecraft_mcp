{
  "schemaVersion": 1,
  "id": "minecraft_mcp",
  "version": "${version}",
  "name": "Minecraft MCP",
  "description": "Control your Minecraft client with JsMacros scripts, screenshots and player takeover.",
  "authors": ["Mak"],
  "contact": {"homepage": "https://github.com/MakkCH"},
  "license": "MIT",
  "icon": "assets/minecraft_mcp/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["minecraft.mcp.MinecraftMcpClient"],
    "modmenu": ["minecraft.mcp.ModMenuIntegration"]
  },
  "depends": {"fabricloader": ">=${loaderVersion}", "minecraft": ["${minecraftVersions}"], "java": ">=25", "fabric-lifecycle-events-v1": "*", "fabric-command-api-v2": "*", "fabric-key-mapping-api-v1": "*", "fabric-networking-api-v1": "*", "jsmacros": ">=2.2.1"},
  "recommends": {"baritone": "*"},
  "suggests": {"modmenu": "*"}
}
